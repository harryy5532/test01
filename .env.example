# ==============================================================================
# BERMUDA PORTAL - ENVIRONMENT CONFIGURATION TEMPLATE
# Platform: Northflank Cloud + Cloudflare Edge + DigitalPlat Ingress
# ==============================================================================

# [Required for Edge Tuning] Cloudflare API Token with Zone/DNS/Ruleset Edit permissions
CLOUDFLARE_API_TOKEN=

# [Optional] Explicit Cloudflare Zone ID (Discovered automatically if empty)
CLOUDFLARE_ZONE_ID=

# [Recommended for Auto-Provisioning] Northflank Platform API Token (JWT Bearer)
NORTHFLANK_API_TOKEN=

# [Optional] Custom Domain routed via Cloudflare (e.g. your DigitalPlat or custom domain)
CUSTOM_DOMAIN=

# [Optional] Master Secret Seed for Deterministic Key Derivation (Auto-generated if empty)
BERMUDA_MASTER_KEY=

# [Optional] Deployment Region Identifier (Default: eu-central)
# Supported: eu-central, eu-west-london, europe-west4, ch-central, us-east4, us-central, us-west, asia-southeast1, asia-northeast, af-south, sa-east
BERMUDA_REGION=eu-central
